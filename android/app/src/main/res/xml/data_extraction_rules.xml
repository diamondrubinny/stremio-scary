<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing of SCARY Web's leaves the device through cloud backup or device-to-device transfer: the library, the
    lists and the PIN hash stay where they are. The app has its own backup file, which the viewer saves by hand.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
